# DevDash 本地开发环境配置
# 复制此文件为 .env.local 并根据需要修改

# === 后端配置 ===
PORT=9090
INTERVAL=5
JWT_SECRET=devdash-dev-secret-key-min-32ch!!
ENCRYPTION_KEY=devdash-encryption-key-32ch!!
DB_PATH=./devdash.db
GIN_MODE=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:9090,http://127.0.0.1:5173

# === 前端配置 ===
VITE_BACKEND_URL=http://localhost:9090
