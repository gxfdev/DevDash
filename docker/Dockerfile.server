# ===== 阶段1: 前端构建 =====
FROM node:20-alpine AS web-builder

RUN apk add --no-cache python3 make g++ \
    && rm -rf /var/cache/apk/*

WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

COPY web/ .
ENV VITE_API_BASE_URL=/api/v1
RUN npx vite build --outDir dist \
    && rm -rf node_modules


# ===== 阶段2: 后端构建 =====
FROM golang:1.26-alpine AS server-builder

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

RUN apk add --no-cache git ca-certificates \
    && rm -rf /var/cache/apk/*

ENV GOWORK=off
ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /build
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.buildDate=${BUILD_DATE} -X main.vcsRef=${VCS_REF}" \
    -trimpath \
    -o /build/devdash ./cmd/server


# ===== 阶段3: 运行时 =====
FROM alpine:3.21

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

# 安装运行时依赖：
# - ca-certificates: HTTPS 通信
# - tzdata: 时区支持
# - curl: 健康检查
# - util-linux: 提供 nsenter，容器内访问主机命名空间
RUN apk add --no-cache ca-certificates tzdata curl util-linux \
    && rm -rf /var/cache/apk/* \
    && addgroup -S devdash \
    && adduser -S devdash -G devdash \
    && mkdir -p /data \
    && chown devdash:devdash /data

LABEL org.opencontainers.image.title="DevDash" \
      org.opencontainers.image.description="Lightweight server monitoring dashboard" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/gxfdev/DevDash" \
      org.opencontainers.image.licenses="MIT"

ENV TZ=Asia/Shanghai
ENV GIN_MODE=release
ENV PORT=9090
ENV DB_PATH=/data/devdash.db
ENV STATIC_DIR=/srv/www
ENV HOST_PROC=/host/proc
ENV HOST_SYS=/host/sys
ENV HOST_DEV=/host/dev
ENV HOST_ETC=/host/etc

COPY --from=server-builder /build/devdash /usr/local/bin/devdash
COPY --from=web-builder /build/web/dist /srv/www

RUN chown -R devdash:devdash /srv/www

USER devdash

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:9090/api/v1/health || exit 1

ENTRYPOINT ["devdash"]
