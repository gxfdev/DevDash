# DevDash Production Environment
# Copy and modify for your deployment target

# === Required ===
DEPLOY_HOST=your-server-ip
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/devdash
DEPLOY_ENV=production

# === Secrets (MUST change for production) ===
JWT_SECRET=change-me-to-a-secure-random-32-char-string!!
ENCRYPTION_KEY=change-me-to-a-secure-32-char-key!!
DB_PASSWORD=change-me-secure-db-password

# === Application ===
PORT=9090
INTERVAL=5
GIN_MODE=release
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
