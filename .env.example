# AIDash 环境变量示例：复制为 .env 后修改
# 密钥生成：openssl rand -hex 32
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASS=admin123
AIDASH_PORT=9090
TZ=Asia/Shanghai
# 对外访问地址（用于生成 API Base URL，可留空自动推断）
PUBLIC_URL=
# 允许跨域的前端来源，逗号分隔（留空使用内置开发地址）
CORS_ORIGINS=

# 构建加速（国内网络可取消注释）
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
ALPINE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
